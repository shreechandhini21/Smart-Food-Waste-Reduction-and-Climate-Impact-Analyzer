# Copy this file to .env and replace the placeholder values.
# NEVER commit a real password to GitHub.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourproject@gmail.com
SMTP_PASSWORD=your_16_character_google_app_password
SMTP_FROM=yourproject@gmail.com
# For local testing only. For real NGO clicks, use a public HTTPS URL.
RESPONSE_BASE_URL=http://localhost:8501
